{
  "name": "Tree search",
  "description": "Search over ideas, keeping the best three each round, until one scores high enough.",
  "shapes": {
    "idea": {
      "text": "text",
      "score": "number"
    }
  },
  "agents": {
    "proposer": {
      "description": "Proposes next steps from the best ideas so far.",
      "instructions": "You are given the best ideas so far. Propose three new ideas that build on\nthem, each different from the others.",
      "accepts": {
        "frontier": "list of idea, optional"
      },
      "answers-with": {
        "ideas": "list of text"
      }
    },
    "scorer": {
      "description": "Scores ideas.",
      "instructions": "Score each idea from 0 to 1 for how likely it is to solve the problem. Give\nthe best score as well.",
      "accepts": {
        "ideas": "list of text"
      },
      "answers-with": {
        "scored": "list of idea",
        "best": "number"
      }
    }
  },
  "workflows": {
    "search": {
      "description": "Search over ideas until one scores 0.9 or four rounds have run.",
      "accepts": {
        "problem": "text"
      },
      "answers-with": {
        "ideas": "list of idea"
      },
      "starts-at": "rounds",
      "steps": {
        "rounds": {
          "does": "repeat",
          "forks": "yes",
          "at-most": 4,
          "until": [
            {
              "value": "steps.score.best",
              "more-than": 0.9
            }
          ],
          "remembers": {
            "frontier": {
              "description": "the best three ideas so far",
              "lasts": "one-run",
              "comes-from": "steps.score.scored",
              "combines-by": "top 3 highest by score"
            }
          },
          "starts-at": "propose",
          "steps": {
            "propose": {
              "does": "call",
              "call": "proposer",
              "bind": {
                "frontier": "remembers.frontier"
              },
              "then": {
                "answered": "score"
              }
            },
            "score": {
              "does": "call",
              "call": "scorer",
              "bind": {
                "ideas": "steps.propose.ideas"
              }
            }
          },
          "then": {
            "answered": "reply",
            "too-many-times": "reply"
          }
        },
        "reply": {
          "does": "answer",
          "bind": {
            "ideas": "steps.rounds.frontier"
          }
        }
      }
    }
  }
}
